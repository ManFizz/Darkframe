{
  "name": "js-gallery",
  "version": "0.2.0",
  "main": "main.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node tools/prepare.js",
    "prepare:env": "node tools/prepare.js",
    "bundle": "node tools/prepare.js && webpack --config webpack.config.js --mode production",
    "bundle:dev": "node tools/prepare.js && webpack --config webpack.config.js --mode development",
    "build": "npm run bundle && electron .",
    "view": "electron .",
    "test": "node tools/run-tests.js",
    "smoke": "node tools/smoke.js",
    "check:fresh": "node tools/fresh-check.js"
  },
  "license": "MIT",
  "dependencies": {
    "animate.css": "^4.1.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "csv-parse": "^7.0.3",
    "electron": "44.4.5",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "onnxruntime-node": "^1.30.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.0.1",
    "sequelize": "6.37.8",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "uiohook-napi": "^1.5.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "sass": "^1.105.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "description": "",
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.30.0": false,
    "sqlite3@6.0.1": true,
    "uiohook-napi@1.5.5": true
  },
  "overrides": {
